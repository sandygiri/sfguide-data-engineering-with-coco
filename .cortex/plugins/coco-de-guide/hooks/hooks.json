{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "bash",
        "hooks": [
          {
            "type": "command",
            "command": "./validate-bash.sh",
            "timeout": 60,
            "enabled": true,
            "statusMessage": "Validating bash command..."
          }
        ]
      }
    ]
  }
}
